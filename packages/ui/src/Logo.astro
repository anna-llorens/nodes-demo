---
/**
 * The NODES wordmark, inline, in UI colours instead of the colours of the official file
 * (assets/logo/source, kept untouched). Letters N, D, E, S use --color-text and the "O"
 * --color-primary; the dark variant (for dark backgrounds) uses white letters and a
 * --color-primary-soft "O" (4.5:1 on --color-primary, 16.6:1 on --color-text).
 * Size it with CSS height; the width follows the aspect ratio.
 */
import source from "../assets/logo/source/NODES_sin_eslogan_fondo_claro.svg?raw";

interface Props {
  /** Accessible name; the wordmark is a proper noun, so "NODES" is the default. */
  label?: string;
  variant?: "light" | "dark";
  class?: string;
}

const LETTERS_FILL = 'fill="#082D2A"';
const O_FILL = 'fill="#00615F"';
if (!source.includes(LETTERS_FILL) || !source.includes(O_FILL)) {
  throw new Error("Logo source colours changed: update the fills in Logo.astro");
}

const { label = "NODES", variant = "light", class: className } = Astro.props;
const escape = (value: string) => value.replace(/&/g, "&amp;").replace(/"/g, "&quot;").replace(/</g, "&lt;");
const classes = ["nodes-logo", `nodes-logo-${variant}`, className].filter(Boolean).join(" ");

const svg = source
  .slice(source.indexOf("<svg"))
  .replace(/<title>[\s\S]*?<\/title>/g, "")
  .replace(/\s(width|height|role|aria-label)="[^"]*"/g, "")
  .replace("<svg", `<svg class="${escape(classes)}" role="img" aria-label="${escape(label)}" focusable="false"`)
  .replace(LETTERS_FILL, 'class="nodes-logo-letters"')
  .replace(O_FILL, 'class="nodes-logo-o"');
---

<Fragment set:html={svg} />

<style is:global>
  .nodes-logo {
    display: block;
    height: 1.5rem;
    width: auto;
  }
  .nodes-logo-light .nodes-logo-letters {
    fill: var(--color-text);
  }
  .nodes-logo-light .nodes-logo-o {
    fill: var(--color-primary);
  }
  .nodes-logo-dark .nodes-logo-letters {
    fill: var(--color-text-inverse);
  }
  .nodes-logo-dark .nodes-logo-o {
    fill: var(--color-primary-soft);
  }
</style>
