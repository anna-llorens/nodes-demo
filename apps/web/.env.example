# Copy this file to .env.local and set the values for your environment.

# Public website URL used by the demo's logo and return link.
PUBLIC_SITE_URL=

# Supabase client configuration. VITE_ values are exposed to the browser and must be public.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase key. Keep this secret and never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only application session secret (at least 32 characters). Required in production.
# Local development generates an ephemeral secret if unset. Login is temporarily admin/admin.
SESSION_SECRET=

# Cron request authentication secrets.
LOVABLE_CRON_SECRET=
LOVABLE_CRON_SECRET_PREVIOUS=

# Optional database migration connection used by Drizzle.
LOVABLE_DB_MIGRATION_URL=
