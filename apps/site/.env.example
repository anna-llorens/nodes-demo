# Copy this file to .env.local and set the values for your environment.
# These variables are public and may end up in the generated HTML; never put secrets here.

# Absolute origin of the site, used for canonical and hreflang URLs. The domain will be
# https://nodes-data.com; leave this empty until that domain points to the site.
# Production builds warn when it is empty (URLs fall back to relative paths).
PUBLIC_SITE_URL=
# Demo (apps/web) URL for the "Demo" nav link; the link is hidden when empty.
PUBLIC_DEMO_URL=
# Contact address. Never hardcode an address or domain in the code.
PUBLIC_CONTACT_EMAIL=
# Project social profiles for the footer; each icon renders only when its URL is set.
# Personal profiles of team members live in src/config/team.ts, not here.
PUBLIC_LINKEDIN_URL=
PUBLIC_X_URL=
# Contact form endpoint: the site Worker's same-origin API, which saves messages in D1 (ADR 0010).
# Works with `pnpm --filter @nodes/site preview`, not with `astro dev`. Without it the form shows
# the email fallback.
PUBLIC_CONTACT_ENDPOINT=/api/contact
