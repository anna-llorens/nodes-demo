# Public website settings. Copy to .env and fill in; every variable is optional.

# Absolute origin of the site, e.g. https://example.org. Used for canonical and hreflang URLs.
# Production builds warn when it is empty (URLs fall back to relative paths).
PUBLIC_SITE_URL=
# Demo (apps/web) URL for the "Demo" nav link; the link is hidden when empty.
PUBLIC_DEMO_URL=
# Temporary contact address. Never hardcode an address or domain in the code.
PUBLIC_CONTACT_EMAIL=
# Social profiles; each icon renders only when its URL is set.
PUBLIC_LINKEDIN_URL=
PUBLIC_X_URL=
# Contact form endpoint (M4). Without it the form shows the email fallback.
PUBLIC_CONTACT_ENDPOINT=
