// Cloudflare Worker for the public site: static assets from ./dist plus a small script for the
// root language redirect, the contact endpoint and the research engagement API. Astro stays fully static.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nodes-demo",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Only these paths reach the script first; everything else is served as a static file.
    "run_worker_first": ["/", "/api/*"]
  },
  // Contact form messages and research article hearts/comments (docs/comments.md). Schema in
  // worker/migrations (wrangler d1 migrations apply). Secrets: TURNSTILE_SECRET, IP_SALT.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nodes-contact",
      "database_id": "d327db8d-30da-4c2d-8796-fd2a0cad79cf",
      "migrations_dir": "worker/migrations"
    }
  ],
  // Copy of every contact message by email (plan D5). Free only to an address verified in the
  // zone's Email Routing; the inbox lives here, never in a PUBLIC_* variable.
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_destination_addresses": ["nodes.data.contact@gmail.com"]
    }
  ],
  "vars": {
    "CONTACT_INBOX": "nodes.data.contact@gmail.com",
    "CONTACT_SENDER": "web@nodes-data.com"
  }
}
