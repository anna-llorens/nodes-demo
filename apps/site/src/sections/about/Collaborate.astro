---
import { Image } from "astro:assets";
import bandImage from "../../assets/research/research-hero.webp";
import Button from "../../components/Button.astro";
import { t, type Locale } from "../../i18n";
import { pagePath } from "../../lib/routes";

/**
 * Closing "Collaborate" band: dark, with the Research hero image behind a left gradient, white
 * text and a button to Contact. The image is decorative here (the Research page describes it).
 */
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
---

<section class="collab" aria-labelledby="about-collab-title">
  <Image class="bg" src={bandImage} alt="" widths={[640, 1024, 1600, 2000]} sizes="100vw" />
  <div class="container text">
    <p class="eyebrow">{t(locale, "about.collab.eyebrow")}</p>
    <h2 id="about-collab-title">{t(locale, "about.collab.title")}</h2>
    <p class="lead">{t(locale, "about.collab.text")}</p>
    <Button href={pagePath(locale, "contact")} variant="outline" arrow>{t(locale, "about.collab.cta")}</Button>
  </div>
</section>

<style>
  .collab {
    position: relative;
    overflow: hidden;
    background: var(--color-surface-inverse);
    color: var(--color-text-inverse);
  }
  .bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: right center;
  }
  /* Solid dark under the text, fading out to the right so the image shows there. */
  .collab::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      var(--color-surface-inverse) 0%,
      color-mix(in srgb, var(--color-surface-inverse) 70%, transparent) 50%,
      transparent 100%
    );
  }
  .text {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
    padding-block: var(--space-12);
  }
  .eyebrow {
    margin: 0;
    font-size: var(--text-eyebrow);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  h2 {
    font-size: var(--text-h2);
    color: var(--color-text-inverse);
  }
  .lead {
    margin: 0 0 var(--space-2);
    max-width: 52ch;
    color: var(--color-text-inverse);
  }
</style>
