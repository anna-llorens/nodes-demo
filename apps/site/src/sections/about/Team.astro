---
import Svg from "@nodes/ui/Svg.astro";
import Eyebrow from "../../components/Eyebrow.astro";
import { team } from "../../config/team";
import { t, type Locale } from "../../i18n";

/**
 * "The people behind NODES": heading with a lead beside it, then one card per founder with an
 * illustrated avatar (no photos), name, role, bio and LinkedIn when set.
 */
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
---

<section class="section" aria-labelledby="about-team-title">
  <div class="container">
    <div class="head">
      <div>
        <Eyebrow>{t(locale, "about.team.eyebrow")}</Eyebrow>
        <h2 id="about-team-title">{t(locale, "about.team.title")}</h2>
      </div>
      <p class="lead">{t(locale, "about.team.lead")}</p>
    </div>
    <ul class="members">
      {
        team.map((member) => {
          const name = t(locale, `team.${member.id}.name`);
          return (
            <li class="member">
              <span class="avatar">
                <Svg name="illustrations/avatar-person" />
              </span>
              <div class="body">
                <h3>{name}</h3>
                <p class="role">{t(locale, `team.${member.id}.role`)}</p>
                <p>{t(locale, `team.${member.id}.text`)}</p>
                {member.linkedinUrl && (
                  <a class="linkedin" href={member.linkedinUrl} rel="noopener" target="_blank" aria-label={t(locale, "team.linkedin", { name })}>
                    <Svg name="social/linkedin" />
                  </a>
                )}
              </div>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<style>
  .head {
    display: grid;
    gap: var(--space-4);
    margin-bottom: var(--space-8);
  }
  h2 {
    margin-top: var(--space-3);
    font-size: var(--text-h2);
    white-space: pre-line;
  }
  p {
    margin: 0;
  }
  .lead {
    max-width: 48ch;
    color: var(--color-text-muted);
  }
  .members {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-6);
  }
  .member {
    display: grid;
    gap: var(--space-5);
    padding: var(--space-4);
    border-radius: var(--radius-card);
    background: var(--color-surface);
    box-shadow: var(--shadow-card);
  }
  /* Illustrated avatar in the photo slot: a neutral silhouette, never a face. */
  .avatar {
    display: flex;
    width: 8rem;
    align-items: flex-end;
    justify-content: center;
    overflow: hidden;
    aspect-ratio: 1;
    border-radius: calc(var(--radius-card) - 4px);
    background: var(--color-primary-soft);
    color: var(--color-primary-line);
  }
  .avatar :global(svg) {
    width: 78%;
    height: auto;
  }
  .body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-2) var(--space-4);
  }
  h3 {
    font-size: 1.25rem;
    font-weight: 600;
  }
  .role {
    color: var(--color-primary);
    font-weight: 600;
  }
  .body p:not(.role) {
    margin-top: var(--space-2);
    color: var(--color-text-muted);
  }
  .linkedin {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin: var(--space-2) 0 0 -10px;
    color: var(--color-text);
  }
  .linkedin:hover {
    color: var(--color-primary);
  }
  .linkedin :global(svg) {
    width: 22px;
    height: 22px;
  }

  @media (min-width: 640px) {
    .member {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      align-items: start;
    }
    .avatar {
      width: auto;
    }
  }
  @media (min-width: 1024px) {
    .head {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
      align-items: end;
      gap: var(--space-12);
    }
    .members {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
