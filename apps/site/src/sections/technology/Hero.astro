---
import heroImage from "../../assets/technology/technology-hero.jpg";
import PageHero from "../../components/PageHero.astro";
import { t, type Locale } from "../../i18n";

/** Technology hero: the shared page hero with a photo bleeding to the right edge (as on Research). */
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
---

<PageHero
  id="tech-hero-title"
  eyebrow={t(locale, "tech.hero.eyebrow")}
  title={t(locale, "tech.hero.title")}
  lead={t(locale, "tech.hero.lead")}
  image={heroImage}
  imageAlt={t(locale, "tech.hero.imageAlt")}
/>
