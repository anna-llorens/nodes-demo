---
import IconCard from "../../components/IconCard.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import StatusLabel from "../../components/StatusLabel.astro";

/** Title, lead and a row of 4 bordered icon cards; shared by features and applications. */
interface Props {
  id: string;
  title: string;
  lead: string;
  cards: { icon: string; title: string; text: string }[];
  /** Status shown under each card's text, e.g. "En la demo". */
  label?: string | undefined;
}
const { id, title, lead, cards, label } = Astro.props;
---

<section class="section" aria-labelledby={id}>
  <div class="container content">
    <SectionHeading id={id} title={title} lead={lead} />
    <div class="cards">
      {cards.map((card) => (
        <IconCard bordered bareIcon layout="row" icon={card.icon} title={card.title} text={card.text}>
          {label && <StatusLabel>{label}</StatusLabel>}
        </IconCard>
      ))}
    </div>
  </div>
</section>

<style>
  .content {
    display: grid;
    gap: var(--section-gap-inner);
  }
  .cards {
    display: grid;
    gap: var(--space-4);
  }
  @media (min-width: 640px) {
    .cards {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .cards {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
