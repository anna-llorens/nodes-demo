---
import maratonImage from "@nodes/ui/assets/png/maraton.jpg";
import mascletaImage from "@nodes/ui/assets/png/mascleta.jpg";
import Button from "../../components/Button.astro";
import { t, type Locale } from "../../i18n";
import { demoScenarioUrl, type DemoScenario } from "../../lib/demo";
import { env } from "../../lib/env";

/**
 * One card per demo scenario with a photo of the place; the button opens it in the demo app when
 * PUBLIC_DEMO_URL is set. Photos are decorative: the title names the scenario.
 */
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const scenarios = (
  [
    ["maraton", "events", maratonImage],
    ["mascleta", "mascleta", mascletaImage],
  ] as const satisfies readonly (readonly [DemoScenario, string, ImageMetadata])[]
).map(([scenario, key, image]) => ({
  id: scenario,
  image,
  title: t(locale, `demo.${key}.title`),
  text: t(locale, `demo.${key}.text`),
  href: demoScenarioUrl(env.demoUrl, scenario, locale),
}));
---

<section class="section" aria-label={t(locale, "nav.demo")}>
  <ul class="container cards">
    {
      scenarios.map((scenario) => (
        <li>
          <article aria-labelledby={`scenario-${scenario.id}`}>
            <img
              class="photo"
              src={scenario.image.src}
              alt=""
              width={scenario.image.width}
              height={scenario.image.height}
              loading="lazy"
              decoding="async"
            />
            <div class="body">
              <h2 id={`scenario-${scenario.id}`}>{scenario.title}</h2>
              <p>{scenario.text}</p>
              {scenario.href && <Button href={scenario.href} arrow>{t(locale, "demo.scenario.cta")}</Button>}
            </div>
          </article>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .cards {
    list-style: none;
    margin-block: 0;
    display: grid;
    gap: var(--space-6);
  }
  article {
    height: 100%;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background: var(--color-surface);
  }
  .photo {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 8;
    object-fit: cover;
    background: var(--color-primary-soft);
  }
  .body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
    padding: var(--space-5);
  }
  h2 {
    margin: 0;
    font-size: 1.25rem;
  }
  p {
    margin: 0 0 var(--space-2);
  }

  @media (min-width: 768px) {
    .cards {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
