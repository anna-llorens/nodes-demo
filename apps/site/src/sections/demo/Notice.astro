---
import Svg from "@nodes/ui/Svg.astro";
import { t, type Locale } from "../../i18n";

/** "This is a simulation" box shown beside the demo hero. */
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
---

<div class="notice" role="note">
  <span class="icon"><Svg name="icons/status-simulation" /></span>

<style>
  .notice {
    display: flex;
    gap: var(--space-4);
    padding: var(--space-5);
    border: 1px solid var(--color-primary-line);
    border-radius: var(--radius-card);
    background: var(--color-primary-soft);
  }
  .icon {
    flex: none;
    width: 32px;
    height: 32px;
    color: var(--color-primary);
  }
  .icon :global(svg) {
    width: 100%;
    height: 100%;
  }
  p {
    margin: 0;
    font-size: var(--text-small);
  }
  .title {
    color: var(--color-text);
    font-size: var(--text-body);
    font-weight: 600;
  }
</style>
