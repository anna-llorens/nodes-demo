---
import Svg from "@nodes/ui/Svg.astro";
import { ArrowRight } from "@lucide/astro";
import SectionHeading from "../../components/SectionHeading.astro";
import { t, type Locale } from "../../i18n";

/** Three numbered steps joined by arrows (desktop) or a vertical line (mobile). */
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const steps = [
  { icon: "icons/lidar-sensor", key: "step1" },
  { icon: "icons/point-cloud", key: "step2" },
  { icon: "icons/chart", key: "step3" },
] as const;
---

<section class="section" aria-labelledby="how-title">
  <div class="container split">
    <SectionHeading id="how-title" eyebrow={t(locale, "how.eyebrow")} title={t(locale, "how.title")} />
    <ol class="steps">
      {steps.map(({ icon, key }, index) => (
        <li class="step">
          <span class="number" aria-hidden="true">{index + 1}</span>
          <div class="body">
            <h3>{t(locale, `how.${key}.title`)}</h3>
            <p>{t(locale, `how.${key}.text`)}</p>
            <span class="art"><Svg name={icon} /></span>
          </div>
          {index < steps.length - 1 && <ArrowRight class="arrow" aria-hidden="true" size={20} />}
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-8);
  }
  .step {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-4);
  }
  /* Mobile: a line joins the numbers. */
  .step:not(:last-child)::before {
    content: "";
    position: absolute;
    top: 2.5rem;
    bottom: calc(-1 * var(--space-8) + var(--space-2));
    left: calc(1rem - 0.5px);
    border-left: 1px solid var(--color-primary-line);
  }
  .number {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: var(--color-primary);
    color: var(--color-text-inverse);
    font-size: var(--text-small);
    font-weight: 700;
  }
  h3 {
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 2rem;
  }
  p {
    margin: var(--space-1) 0 0;
  }
  .art {
    display: block;
    width: 5.5rem;
    height: 5.5rem;
    margin-top: var(--space-4);
    color: var(--color-primary-decor);
  }
  .art :global(svg) {
    width: 100%;
    height: 100%;
  }
  .step :global(.arrow) {
    display: none;
  }

  @media (min-width: 1024px) {
    .steps {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-8);
    }
    .step {
      grid-template-columns: auto 1fr;
      gap: var(--space-3);
      padding-right: var(--space-4);
    }
    .step:not(:last-child)::before {
      display: none;
    }
    .step :global(.arrow) {
      display: block;
      position: absolute;
      top: 0.375rem;
      right: calc(-1 * var(--space-8) / 2 - 10px);
      color: var(--color-primary);
    }
  }
</style>
