---
import Svg from "@nodes/ui/Svg.astro";
import { Image } from "astro:assets";
import lidarImage from "../../assets/research/lidar-point-cloud-plaza.jpg";
import Button from "../../components/Button.astro";
import Eyebrow from "../../components/Eyebrow.astro";
import { t, type Locale } from "../../i18n";
import { articleFor, articlePath } from "../../lib/research";
import { pagePath } from "../../lib/routes";

/**
 * "What we are researching": two topic cards with an image (or an icon panel) and a button to Research. A topic
 * whose article is published in this locale links to it; the title link covers the whole card.
 */
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const topics = await Promise.all(
  (
    [
      { key: "lidar", icon: "icons/point-cloud", image: lidarImage },
      { key: "prediction", icon: "icons/chart", image: undefined },
    ] as const
  ).map(async (topic) => {
    const article = await articleFor(topic.key, locale);
    return { ...topic, href: article && articlePath(article) };
  }),
);
---

<section class="section" aria-labelledby="home-research-title">
  <div class="container">
    <div class="head">
      <div>
        <Eyebrow>{t(locale, "home.research.eyebrow")}</Eyebrow>
        <h2 id="home-research-title">{t(locale, "home.research.title")}</h2>
      </div>
      <Button href={pagePath(locale, "research")} variant="outline" arrow>{t(locale, "home.research.cta")}</Button>
    </div>
    <ul class="cards">
      {
        topics.map((topic) => (
          <li>
            <article class:list={{ linked: topic.href }}>
              {topic.image ? (
                <Image class="photo" src={topic.image} alt="" widths={[480, 800, 1200]} sizes="(min-width: 768px) 50vw, 100vw" />
              ) : (
                <span class="panel"><Svg name={topic.icon} /></span>
              )}
              <h3>
                {topic.href ? (
                  <a href={topic.href}>{t(locale, `home.research.${topic.key}.title`)}</a>
                ) : (
                  t(locale, `home.research.${topic.key}.title`)
                )}
              </h3>
              <p>{t(locale, `home.research.${topic.key}.text`)}</p>
            </article>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-8);
  }
  h2 {
    margin: 0;
  }
  .cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-6);
  }
  article {
    height: 100%;
    overflow: hidden;
    border-radius: var(--radius-card);
    background: var(--color-surface);
    box-shadow: var(--shadow-card);
  }
  /* Linked card: the title link stretches over the whole card. */
  .linked {
    position: relative;
    outline: 2px solid transparent;
    transition: outline-color 0.15s;
  }
  .linked:hover,
  .linked:has(a:focus-visible) {
    outline-color: var(--color-primary);
  }
  .linked h3 a {
    color: inherit;
    text-decoration: none;
  }
  .linked h3 a::after {
    content: "";
    position: absolute;
    inset: 0;
  }
  .linked h3 a:focus-visible {
    outline: none;
  }
  .panel {
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 7;
    background: var(--color-primary-soft);
    color: var(--color-primary);
  }
  /* Decorative card image, same frame as the icon panel. */
  .photo {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 7;
    object-fit: cover;
  }
  .panel :global(svg) {
    width: 72px;
    height: 72px;
  }
  h3,
  p {
    margin: 0;
    padding-inline: var(--space-5);
  }
  h3 {
    padding-top: var(--space-4);
  }
  p {
    padding-block: var(--space-2) var(--space-5);
    color: var(--color-text-muted);
  }

  @media (min-width: 768px) {
    .cards {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
