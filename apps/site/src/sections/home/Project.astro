---
import Svg from "@nodes/ui/Svg.astro";
import { ArrowRight } from "@lucide/astro";
import { t, type Locale } from "../../i18n";
import { pagePath } from "../../lib/routes";

/** "A project in development": the guiding question, three short paragraphs and a link to About. */
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const paragraphs = (["paragraph1", "paragraph2", "paragraph3"] as const).map((key) => t(locale, `home.project.${key}`));
---

<section class="section project" aria-labelledby="home-project-title">
  <div class="container layout">
    <div class="text">
      <h2 id="home-project-title">{t(locale, "home.project.title")}</h2>
      <p class="question">{t(locale, "home.project.question")}</p>
      {paragraphs.map((text) => <p>{text}</p>)}
      <a class="more" href={pagePath(locale, "about")}>
        {t(locale, "home.project.cta")}
        <ArrowRight aria-hidden="true" size={18} />
      </a>
    </div>
    <span class="art"><Svg name="illustrations/skyline-header" /></span>
  </div>
</section>

<style>
  .project {
    background: var(--color-surface-muted);
  }
  .text {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  h2,
  p {
    margin: 0;
    max-width: 60ch;
  }
  .question {
    color: var(--color-text);
    font-size: 1.125rem;
    font-weight: 500;
  }
  .more {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    gap: var(--space-2);
    color: var(--color-primary);
    font-weight: 600;
    text-decoration: none;
  }
  .more:hover {
    text-decoration: underline;
  }
  .art {
    display: block;
    margin-top: var(--space-8);
    color: var(--color-primary);
  }
  .art :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }

  @media (min-width: 1024px) {
    .layout {
      display: grid;
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      align-items: center;
      gap: var(--space-12);
    }
    .art {
      margin: 0;
    }
  }
</style>
