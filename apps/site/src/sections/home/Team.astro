---
import Svg from "@nodes/ui/Svg.astro";
import Avatar from "../../components/Avatar.astro";
import Button from "../../components/Button.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import { team } from "../../config/team";
import { t, type Locale } from "../../i18n";
import { pagePath } from "../../lib/routes";

/** Team cards (initials, name, role, one line, LinkedIn when set) and a link to Sobre nosotras. */
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
---

<section class="section" aria-labelledby="team-title">
  <div class="container split">
    <SectionHeading id="team-title" eyebrow={t(locale, "team.eyebrow")} title={t(locale, "team.title")} lead={t(locale, "team.lead")}>
      <Button href={pagePath(locale, "about")} variant="outline" arrow>{t(locale, "team.more")}</Button>
    </SectionHeading>
    <ul class="members">
      {team.map((member) => {
        const name = t(locale, `team.${member.id}.name`);
        return (
          <li class="member">
            <Avatar initials={member.initials} />
            <div>
              <h3>{name}</h3>
              <p class="role">{t(locale, `team.${member.id}.role`)}</p>
              <p>{t(locale, `team.${member.id}.text`)}</p>
              {member.linkedinUrl && (
                <a class="linkedin" href={member.linkedinUrl} rel="noopener" target="_blank" aria-label={t(locale, "team.linkedin", { name })}>
                  <Svg name="social/linkedin" />
                </a>
              )}
            </div>
          </li>
        );
      })}
    </ul>
  </div>
</section>

<style>
  .members {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-4);
  }
  .member {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-6);
    border-radius: var(--radius-card);
    background: var(--color-surface);
    box-shadow: var(--shadow-card);
  }
  h3 {
    font-size: 1.0625rem;
    font-weight: 600;
  }
  p {
    margin: var(--space-2) 0 0;
  }
  .role {
    margin-top: var(--space-1);
    color: var(--color-text-muted);
    font-size: var(--text-small);
  }
  .linkedin {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin: var(--space-2) 0 0 -10px;
    color: var(--color-text);
  }
  .linkedin:hover {
    color: var(--color-primary);
  }
  .linkedin :global(svg) {
    width: 22px;
    height: 22px;
  }
  @media (min-width: 640px) {
    .members {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .member {
      flex-direction: row;
      align-items: flex-start;
    }
  }
</style>
