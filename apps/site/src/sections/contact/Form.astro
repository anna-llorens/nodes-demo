---
import Svg from "@nodes/ui/Svg.astro";
import { ArrowRight, X } from "@lucide/astro";
import Checkbox from "../../components/form/Checkbox.astro";
import Field from "../../components/form/Field.astro";
import { t, type Locale } from "../../i18n";
import { withLink } from "../../i18n/with-link";
import { contactInterests, defaultInterest } from "../../lib/contact";
import { contactEndpoint, env } from "../../lib/env";
import { pagePath } from "../../lib/routes";

/**
 * The contact form (left) and the "write to us" card (right; below on mobile). The form starts
 * with three interest cards (radios; one is always selected, from `?interest=` or the default).
 * States: idle, field error, sending, sent, send error; switched by the script at the end.
 */
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const endpoint = contactEndpoint();
const privacyLink = t(locale, "contact.form.consentLink");
const consent = withLink(t(locale, "contact.form.consent"));
const privacyInfo = withLink(t(locale, "collab.form.privacyInfo"));
const required = t(locale, "collab.form.required");
const emailParts = env.contactEmail?.split("@");
const interests = (
  [
    ["pilot", "icons/handshake"],
    ["research", "icons/graduation-cap"],
    ["general", "icons/lightbulb"],
  ] as const satisfies readonly (readonly [(typeof contactInterests)[number], string])[]
).map(([id, icon]) => ({
  id,
  icon,
  title: t(locale, `contact.interests.${id}.title`),
  text: t(locale, `contact.interests.${id}.text`),
}));
---

<section class="section contact" aria-labelledby="contact-hero-title">
  <div class="container layout">
    <div class="form-column">
      <form id="contact-form" class="form" novalidate data-endpoint={endpoint} data-locale={locale}>
        <fieldset class="interests">
          <legend>{t(locale, "contact.form.interest")}</legend>
          {
            interests.map((interest) => (
              <label class="interest">
                <input type="radio" name="interest" value={interest.id} checked={interest.id === defaultInterest} />
                <span class="interest-icon"><Svg name={interest.icon} /></span>
                <span class="interest-title">{interest.title}</span>
                <span class="interest-text">{interest.text}</span>
              </label>
            ))
          }
        </fieldset>
        <div class="row">
          <Field
            id="contact-name"
            name="name"
            label={t(locale, "contact.form.name")}
            placeholder={t(locale, "contact.form.namePlaceholder")}
            autocomplete="name"
            requiredLabel={required}
            error={t(locale, "collab.form.errors.name")}
          />
          <Field
            id="contact-email"
            name="email"
            type="email"
            label={t(locale, "contact.form.email")}
            placeholder={t(locale, "contact.form.emailPlaceholder")}
            autocomplete="email"
            requiredLabel={required}
            error={t(locale, "collab.form.errors.email")}
          />
        </div>
        <Field
          id="contact-organization"
          name="organization"
          label={t(locale, "contact.form.organization")}
          placeholder={t(locale, "contact.form.organizationPlaceholder")}
          autocomplete="organization"
          error=""
        />
        <Field
          id="contact-message"
          name="message"
          multiline
          label={t(locale, "contact.form.message")}
          placeholder={t(locale, "contact.form.messagePlaceholder")}
          requiredLabel={required}
          error={t(locale, "collab.form.errors.message")}
        />
        {/* Honeypot: invisible to people and skipped by keyboard; bots that fill it get a fake success. */}
        <div class="honeypot" aria-hidden="true">
          <input type="text" name="website" tabindex="-1" autocomplete="off" />
        </div>
        <div class="submit-row">
          <Checkbox id="contact-consent" name="consent" required error={t(locale, "collab.form.errors.consent")}>
            {consent.before}<a href={pagePath(locale, "privacy")}>{privacyLink}</a>{consent.after}
          </Checkbox>
          <button class="button button-primary submit" type="submit">
            <span class="spinner" aria-hidden="true" hidden></span>
            <span data-label="idle">{t(locale, "contact.form.submit")}</span>
            <span data-label="sending" hidden>{t(locale, "collab.form.sending")}</span>
            <ArrowRight class="submit-arrow" aria-hidden="true" size={18} />
          </button>
        </div>
        <p class="privacy-info">
          {privacyInfo.before}<a href={pagePath(locale, "privacy")}>{privacyLink}</a>{privacyInfo.after}
        </p>

        <div class="send-error" data-send-error role="alert" hidden>
          <p class="state-title">{t(locale, "contact.form.errorTitle")}</p>
          <p>
            {t(locale, "contact.form.errorText")}
            {env.contactEmail && <a href={`mailto:${env.contactEmail}`}>{env.contactEmail}</a>}
          </p>
        </div>
        <p class="visually-hidden" data-live aria-live="polite"></p>
      </form>

      <div class="sent" data-sent tabindex="-1" role="status" hidden>
        <button type="button" class="sent-close" data-sent-close aria-label={t(locale, "contact.form.successClose")}>
          <X aria-hidden="true" size={18} />
        </button>
        <p class="state-title">{t(locale, "contact.form.successTitle")}</p>
        <p>{t(locale, "contact.form.successText")}</p>
      </div>
    </div>

    <aside class="direct" aria-labelledby="contact-direct-title">
      <h2 id="contact-direct-title">{t(locale, "contact.direct.title")}</h2>
      <ul class="channels">
        {
          env.contactEmail && (
            <li>
              <span class="channel-icon"><Svg name="icons/mail" /></span>
              <span>
                <a href={`mailto:${env.contactEmail}`}>
                  {emailParts?.[0]}@<wbr />
                  {emailParts?.slice(1).join("@")}
                </a>
              </span>
            </li>
          )
        }
      </ul>
      <p>{t(locale, "contact.direct.text")}</p>
      <div class="status">
        <p class="status-title">{t(locale, "contact.status.title")}</p>
        <p>{t(locale, "contact.status.text")}</p>
      </div>
    </aside>
  </div>
</section>

<script>
  import { interestFromQuery, submitContact, toPayload, validateContact, type ContactField } from "../../lib/contact";

  const form = document.querySelector<HTMLFormElement>("#contact-form");
  const sent = document.querySelector<HTMLElement>("[data-sent]");

  if (form && sent) {
    const control = <T extends HTMLElement>(name: string) => form.querySelector<T>(`[name="${name}"]`)!;
    const submit = form.querySelector<HTMLButtonElement>("button[type=submit]")!;
    const sendError = form.querySelector<HTMLElement>("[data-send-error]")!;
    const live = form.querySelector<HTMLElement>("[data-live]")!;
    const fields: ContactField[] = ["name", "email", "message", "consent"];
    // Not importing isLocale here keeps the i18n dictionaries out of the client bundle.
    const locale = form.dataset["locale"] === "en" ? "en" : "es";

    // Preselect the interest named in the URL (e.g. the Applications pilot band).
    const preselected = interestFromQuery(new URLSearchParams(location.search).get("interest"));
    form.querySelector<HTMLInputElement>(`[name="interest"][value="${preselected}"]`)!.checked = true;

    const setError = (field: ContactField, invalid: boolean) => {
      control(field).setAttribute("aria-invalid", String(invalid));
      form.querySelector<HTMLElement>(`[data-error-for="${field}"]`)!.hidden = !invalid;
    };
    // Editing a field clears its error; the full check runs again on submit.
    for (const field of fields) {
      control(field).addEventListener(field === "consent" ? "change" : "input", () => setError(field, false));
    }

    const setSending = (sending: boolean) => {
      submit.disabled = sending;
      form.setAttribute("aria-busy", String(sending));
      submit.querySelector<HTMLElement>(".spinner")!.hidden = !sending;
      submit.querySelector<HTMLElement>("[data-label=idle]")!.hidden = sending;
      submit.querySelector<HTMLElement>("[data-label=sending]")!.hidden = !sending;
    };

    const showSent = () => {
      form.hidden = true;
      sent.hidden = false;
      sent.focus();
    };

    // Closing the confirmation brings back an empty form for another message.
    sent.querySelector<HTMLButtonElement>("[data-sent-close]")!.addEventListener("click", () => {
      form.reset();
      form.querySelector<HTMLInputElement>(`[name="interest"][value="${preselected}"]`)!.checked = true;
      for (const field of fields) setError(field, false);
      sent.hidden = true;
      form.hidden = false;
      control("name").focus();
    });

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      sendError.hidden = true;
      if (control<HTMLInputElement>("website").value) return showSent();

      const values = {
        name: control<HTMLInputElement>("name").value,
        email: control<HTMLInputElement>("email").value,
        organization: control<HTMLInputElement>("organization").value,
        interest: form.querySelector<HTMLInputElement>('[name="interest"]:checked')?.value ?? "",
        message: control<HTMLTextAreaElement>("message").value,
        consent: control<HTMLInputElement>("consent").checked,
      };
      const invalid = validateContact(values);
      for (const field of fields) setError(field, invalid.includes(field));
      if (invalid.length > 0) {
        live.textContent = invalid
          .map((field) => form.querySelector<HTMLElement>(`[data-error-for="${field}"]`)!.textContent)
          .join(" ");
        control(invalid[0]!).focus();
        return;
      }

      live.textContent = "";
      setSending(true);
      const result = await submitContact(toPayload(values, locale), { endpoint: form.dataset["endpoint"] });
      setSending(false);
      if (result.ok) showSent();
      else sendError.hidden = false;
    });
  }
</script>

<style>
  /* Sits right under the page hero. */
  .contact {
    padding-top: var(--space-8);
  }
  .layout {
    display: grid;
    gap: var(--space-12);
  }
  .form-column {
    display: grid;
    gap: var(--section-gap-inner);
    align-content: start;
  }
  .form {
    display: grid;
    gap: var(--space-5);
  }
  .interests {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    border: 0;
  }
  legend {
    margin-bottom: var(--space-3);
    padding: 0;
    color: var(--color-text);
    font-weight: 600;
  }
  .interest {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-1) var(--space-3);
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background: var(--color-surface);
    cursor: pointer;
  }
  .interest:has(:checked) {
    border-color: var(--color-primary);
    background: var(--color-primary-soft);
  }
  .interest:has(:focus-visible) {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }
  .interest input {
    position: absolute;
    opacity: 0;
  }
  .interest-icon {
    grid-row: span 2;
    width: 32px;
    height: 32px;
    color: var(--color-primary);
  }
  .interest-icon :global(svg) {
    width: 100%;
    height: 100%;
  }
  .interest-title {
    color: var(--color-text);
    font-weight: 600;
  }
  .interest-text {
    color: var(--color-text-muted);
    font-size: var(--text-small);
  }
  .form[hidden] {
    display: none;
  }
  .row {
    display: grid;
    gap: var(--space-5);
  }
  .honeypot {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .submit-row {
    display: grid;
    gap: var(--space-5);
  }
  .submit {
    width: 100%;
    border: none;
    cursor: pointer;
  }
  .submit:disabled {
    cursor: progress;
    opacity: 0.8;
  }
  .submit [hidden] {
    display: none;
  }
  .spinner {
    width: 1rem;
    height: 1rem;
    border: 2px solid currentColor;
    border-right-color: transparent;
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
  .privacy-info {
    margin: 0;
    font-size: var(--text-small);
    color: var(--color-text-muted);
  }
  .send-error,
  .sent {
    padding: var(--space-5) var(--space-6);
    border-radius: var(--radius-card);
    border: 1px solid var(--color-border);
    background: var(--color-surface);
  }
  .send-error {
    border-color: var(--color-error);
  }
  .send-error[hidden],
  .sent[hidden] {
    display: none;
  }
  .send-error p,
  .sent p {
    margin: 0;
  }
  .state-title {
    color: var(--color-text);
    font-weight: 600;
    margin-bottom: var(--space-1) !important;
  }
  .send-error .state-title {
    color: var(--color-error);
  }
  .sent {
    position: relative;
    padding-right: var(--space-12);
    border-color: var(--color-primary-line);
    background: var(--color-primary-soft);
  }
  .sent-close {
    position: absolute;
    top: var(--space-3);
    right: var(--space-3);
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: 0;
    border-radius: var(--radius-card);
    background: transparent;
    color: var(--color-text);
    cursor: pointer;
  }
  .sent-close:hover {
    background: var(--color-surface);
  }
  .direct {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-6);
    border-radius: var(--radius-card);
    background: var(--color-primary-soft);
  }
  .direct h2 {
    font-size: 1.25rem;
    font-weight: 700;
  }
  .direct p {
    margin: 0;
  }
  .channels {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-4);
  }
  .channels li {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }
  .channels li > span:last-child {
    display: flex;
    flex-direction: column;
  }
  .channel-icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: var(--color-surface);
    color: var(--color-primary);
  }
  .channel-icon :global(svg) {
    width: 55%;
    height: 55%;
  }
  .channels a {
    overflow-wrap: break-word;
    font-weight: 600;
  }
  .status {
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-primary-line);
    font-size: var(--text-small);
  }
  .status-title {
    color: var(--color-text);
    font-weight: 600;
  }

  @media (min-width: 640px) {
    .row {
      grid-template-columns: 1fr 1fr;
    }
    .submit-row {
      grid-template-columns: 1fr auto;
      align-items: start;
    }
    .submit {
      width: auto;
    }
  }
  @media (min-width: 768px) {
    .interests {
      grid-template-columns: repeat(3, 1fr);
    }
    .interests legend {
      grid-column: 1 / -1;
    }
    .interest {
      grid-template-columns: 1fr;
    }
    .interest-icon {
      grid-row: auto;
    }
  }
  @media (min-width: 1024px) {
    .layout {
      grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
      align-items: start;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .spinner {
      animation-duration: 2.4s !important;
    }
  }
</style>
