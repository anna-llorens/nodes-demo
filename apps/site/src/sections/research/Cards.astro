---
import { Image } from "astro:assets";
import Svg from "@nodes/ui/Svg.astro";
import { t, type Locale } from "../../i18n";
import { articleFor, cardIcons, articlePath, formatArticleDate } from "../../lib/research";

/**
 * Topic chips and the six research cards. The chips filter the cards by topic with a small
 * script; without JS every card stays visible and the chips do nothing. A card whose article is published in this
 * locale links to it (the title link covers the whole card) and shows the publication date;
 * the others keep the "coming soon" label. A published article with a `cover` shows it instead of
 * the icon panel. Status note below.
 */
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const filters = (["all", "lidar", "crowd", "iot", "prediction", "useCases"] as const).map((key) => ({
  key,
  label: t(locale, `research.filters.${key}`),
}));
// Topic of each card while it has no article; a published article's own `category` wins.
const cardTopics: Record<keyof typeof cardIcons, string> = {
  lidar: "lidar",
  prediction: "crowd",
  edge: "iot",
  events: "useCases",
  decision: "prediction",
  architecture: "iot",
  openData: "lidar",
};
const cards = await Promise.all(
  (
  Object.entries(cardIcons) as [keyof typeof cardIcons, (typeof cardIcons)[keyof typeof cardIcons]][]
).map(async ([key, icon]) => {
    const article = await articleFor(key, locale);
    return {
      key,
      icon,
      topic: article?.data.category ?? cardTopics[key],
      category: t(locale, `research.cards.${key}.category`),
      title: t(locale, `research.cards.${key}.title`),
      description: t(locale, `research.cards.${key}.description`),
      type: t(locale, `research.cards.${key}.type`),
      href: article && articlePath(article),
      date: article?.data.date || undefined,
      cover: article?.data.cover,
    };
  }),
);
---

<section class="section" aria-label={t(locale, "nav.research")}>
  <div class="container">
    <ul class="chips">
      {
        filters.map((filter) => (
          <li>
            <button type="button" data-filter={filter.key} aria-pressed={filter.key === "all" ? "true" : "false"}>
              {filter.label}
            </button>
          </li>
        ))
      }
    </ul>
    <ul class="cards">
      {
        cards.map((card) => (
          <li data-topic={card.topic}>
            <article class:list={{ linked: card.href }} aria-labelledby={`research-${card.key}`}>
              {card.cover ? (
                <Image class="photo" src={card.cover} alt="" widths={[480, 800, 1200]} sizes="(min-width: 768px) 50vw, 100vw" />
              ) : (
                <span class="panel"><Svg name={card.icon} /></span>
              )}
              <div class="body">
                <p class="category">{card.category}</p>
                <h2 id={`research-${card.key}`}>{card.href ? <a href={card.href}>{card.title}</a> : card.title}</h2>
                <p>{card.description}</p>
                <p class="meta">
                  <span>{card.type}</span>
                  {card.date ? (
                    <time class="soon" datetime={card.date}>
                      {formatArticleDate(card.date, locale)}
                    </time>
                  ) : (
                    <span class="soon">{t(locale, "research.comingSoon")}</span>
                  )}
                </p>
              </div>
            </article>
          </li>
        ))
      }
    </ul>
    <p class="note">{t(locale, "research.statusNote")}</p>
  </div>
</section>

<script>
  // Shows only the cards of the pressed topic; "all" shows every card.
  const buttons = [...document.querySelectorAll<HTMLButtonElement>("[data-filter]")];
  const items = [...document.querySelectorAll<HTMLLIElement>("[data-topic]")];
  buttons.forEach((button) =>
    button.addEventListener("click", () => {
      const filter = button.dataset["filter"];
      buttons.forEach((other) => other.setAttribute("aria-pressed", String(other === button)));
      items.forEach((item) => (item.hidden = filter !== "all" && item.dataset["topic"] !== filter));
    }),
  );
</script>

<style>
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-8);
  }
  .chips button {
    font: inherit;
    color: inherit;
    cursor: pointer;
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    font-size: var(--text-small);
  }
  .chips button:hover {
    border-color: var(--color-primary);
  }
  .chips [aria-pressed="true"] {
    border-color: var(--color-primary);
    background: var(--color-primary);
    color: var(--color-text-inverse);
  }
  .cards {
    display: grid;
    gap: var(--space-6);
  }
  article {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background: var(--color-surface);
  }
  /* Linked card: the title link stretches over the whole card. */
  .linked {
    position: relative;
    transition: border-color 0.15s;
  }
  .linked:hover,
  .linked:focus-within {
    border-color: var(--color-primary);
  }
  .linked h2 a {
    color: inherit;
    text-decoration: none;
  }
  .linked h2 a::after {
    content: "";
    position: absolute;
    inset: 0;
  }
  .linked h2 a:focus-visible {
    outline: none;
  }
  .linked:has(a:focus-visible) {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }
  .panel {
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 8;
    background: var(--color-primary-soft);
    color: var(--color-primary);
  }
  /* Same frame as the icon panel, so photo and icon cards line up. */
  .photo {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 8;
    object-fit: cover;
  }
  .panel :global(svg) {
    width: 64px;
    height: 64px;
  }
  .body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-5);
  }
  h2 {
    margin: 0;
    font-size: 1.125rem;
  }
  p {
    margin: 0;
  }
  .category {
    color: var(--color-text-muted);
    font-size: var(--text-eyebrow);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2);
    margin-top: auto;
    padding-top: var(--space-3);
    color: var(--color-text-muted);
    font-size: var(--text-small);
  }
  .soon {
    padding-inline: var(--space-2);
    border-radius: var(--radius-pill);
    background: var(--color-primary-soft);
    color: var(--color-primary);
    font-weight: 600;
  }
  .note {
    margin-top: var(--space-8);
    color: var(--color-text-muted);
    font-size: var(--text-small);
  }

  @media (min-width: 768px) {
    .cards {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (min-width: 1024px) {
    .cards {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
