---
import { ExternalLink, Info } from "@lucide/astro";
import Button from "../../components/Button.astro";
import Eyebrow from "../../components/Eyebrow.astro";
import CapacityCalculator from "../../components/capacity/CapacityCalculator.astro";
import { t, type Locale } from "../../i18n";
import { pagePath } from "../../lib/routes";

/**
 * "Research tools": the compact capacity calculator inside a card, with links to the full page
 * and its methodology. The button carries the current values, so the page opens the same
 * calculation.
 */
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const page = pagePath(locale, "capacityCalculator");
---

<section id="tools" class="section tools" aria-labelledby="research-tools-title">
  <div class="container">
    <div class="head">
      <Eyebrow>{t(locale, "research.tools.eyebrow")}</Eyebrow>
      <h2 id="research-tools-title">{t(locale, "research.tools.title")}</h2>
      <p class="lead">{t(locale, "research.tools.lead")}</p>
    </div>
    <div class="card" data-tools-card>
      <CapacityCalculator locale={locale} id="research-calc" compact infoText={t(locale, "research.tools.info")} />
      <div class="foot">
        <Button href={page} arrow class="open">{t(locale, "research.tools.open")}</Button>
        <a class="method" href={`${page}#metodologia`}>
          <ExternalLink aria-hidden="true" size={18} />
          {t(locale, "research.tools.method")}
        </a>
        <p class="notice">
          <Info aria-hidden="true" size={18} />
          {t(locale, "research.tools.notice")}
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  // Keep "Open calculator" in step with the block's values.
  for (const card of document.querySelectorAll<HTMLElement>("[data-tools-card]")) {
    const link = card.querySelector<HTMLAnchorElement>(".open")!;
    const base = link.pathname;
    card.addEventListener("capacity-change", (event) => {
      link.href = `${base}?${(event as CustomEvent<string>).detail}`;
    });
  }
</script>

<style>
  .head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
    max-width: 48rem;
    margin-bottom: var(--space-8);
  }
  h2 {
    font-size: var(--text-h2);
  }
  .lead {
    margin: 0;
    font-size: 1.125rem;
  }
  .card {
    display: grid;
    gap: var(--space-6);
    padding: var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background: var(--color-surface);
    box-shadow: var(--shadow-card);
  }
  .foot {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border);
  }
  .method,
  .notice {
    display: inline-flex;
    align-items: flex-start;
    gap: var(--space-2);
    margin: 0;
    font-size: var(--text-small);
  }
  .method {
    color: var(--color-primary);
    font-weight: 600;
  }
  .notice {
    color: var(--color-text-muted);
  }
  .foot :global(svg) {
    flex: none;
  }
  @media (min-width: 1024px) {
    .card {
      padding: var(--space-8);
    }
    .foot {
      flex-direction: row;
      align-items: center;
      gap: var(--space-6);
    }
    .notice {
      margin-left: auto;
      max-width: 22rem;
    }
  }
</style>
