---
import "@fontsource/inter/400.css";
import "@fontsource/inter/600.css";
import "@fontsource/inter/700.css";
import "../styles/global.css";
import Favicons from "../components/Favicons.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { locales, t, type Locale } from "../i18n";
import { absoluteUrl, isPreviewHost } from "../lib/env";
import { pagePath, pages, type PageId } from "../lib/routes";

/** Page shell: <html lang>, meta, canonical and hreflang, header and footer. */
interface Props {
  locale: Locale;
  /** The page, for canonical, hreflang and the active nav item. Omit for pages without a locale twin (404). */
  page?: PageId | undefined;
  /** Keep the page out of search results (404, legal drafts). */
  noindex?: boolean;
  /** Document title for pages outside the catalog (articles); "· NODES" is appended. */
  title?: string | undefined;
  /** Meta description for pages outside the catalog (articles); catalog pages use their own key. */
  description?: string | undefined;
  /**
   * Translations of a page outside the catalog (articles), itself included: canonical, hreflang
   * and x-default (English) come from here instead of `page`.
   */
  translations?: { locale: Locale; path: string }[] | undefined;
  /** Language switcher targets for pages outside the catalog. */
  languageHrefs?: Partial<Record<Locale, string>> | undefined;
  /** Research articles: `og:type=article`, the article:* tags and their own share image. */
  article?: ArticleMeta | undefined;
}

export interface ArticleMeta {
  /** ISO dates. */
  published?: string | undefined;
  modified?: string | undefined;
  section?: string | undefined;
  tags?: string[] | undefined;
  /** Share image already generated at its final size, with an absolute URL. */
  image?: { url: string; width: number; height: number; alt?: string | undefined } | undefined;
}

const {
  locale,
  page,
  noindex = false,
  title: pageTitle,
  description: pageDescription,
  translations,
  languageHrefs,
  article,
} = Astro.props;

// Catalog titles that already name the brand (`meta.<page>.title`) are used as they are.
const withBrand = (text: string) => (text.includes("NODES") ? text : `${text} · NODES`);
const title = pageTitle
  ? `${pageTitle} · NODES`
  : !page || page === "home"
    ? t(locale, "meta.title")
    : withBrand(t(locale, pages[page].titleKey));
const description = pageDescription ?? t(locale, page ? pages[page].descriptionKey : "meta.description");
// Articles share their cover; every other page the default image (1200×630, cropped from the home page asset).
const ogImage = article?.image ?? { url: absoluteUrl("/og-default.jpg"), width: 1200, height: 630, alt: undefined };
const paths = translations ?? (page ? locales.map((item) => ({ locale: item, path: pagePath(item, page) })) : []);
const alternates = paths.map((item) => ({ locale: item.locale, href: absoluteUrl(item.path) }));
const canonical = alternates.find((item) => item.locale === locale)?.href;
const xDefault = alternates.find((item) => item.locale === "en")?.href;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <Favicons />
    <meta name="description" content={description} />
    {(noindex || isPreviewHost) && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}
    {alternates.map((item) => <link rel="alternate" hreflang={item.locale} href={item.href} />)}
    {xDefault && <link rel="alternate" hreflang="x-default" href={xDefault} />}
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={locale === "es" ? "es_ES" : "en_GB"} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:site_name" content="NODES" />
    <meta property="og:image" content={ogImage.url} />
    <meta property="og:image:width" content={String(ogImage.width)} />
    <meta property="og:image:height" content={String(ogImage.height)} />
    {ogImage.alt && <meta property="og:image:alt" content={ogImage.alt} />}
    {article?.published && <meta property="article:published_time" content={article.published} />}
    {article?.modified && <meta property="article:modified_time" content={article.modified} />}
    {article?.section && <meta property="article:section" content={article.section} />}
    {article?.tags?.filter(Boolean).map((tag) => <meta property="article:tag" content={tag} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage.url} />
    {ogImage.alt && <meta name="twitter:image:alt" content={ogImage.alt} />}
    <slot name="head" />
  </head>
  <body>
    <Header locale={locale} page={page} languageHrefs={languageHrefs} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
