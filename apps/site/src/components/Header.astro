---
import { Menu, X } from "@lucide/astro";
import { t, type Locale } from "../i18n";
import { mainNav, pagePath, pages, type PageId } from "../lib/routes";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import Logo from "./Logo.astro";

/**
 * Sticky header. Desktop: logo · centred nav · language links.
 * Mobile: logo · language links · menu button opening the nav.
 */
interface Props {
  locale: Locale;
  page?: PageId | undefined;
}
const { locale, page } = Astro.props;

const links = mainNav.map((id) => ({ href: pagePath(locale, id), label: t(locale, pages[id].titleKey), current: id === page }));
---

<header class="site-header" data-site-header>
  <div class="container bar">
    <Logo locale={locale} />

    <nav class="nav-desktop">
      <ul>
        {links.map((link) => (
          <li><a href={link.href} aria-current={link.current ? "page" : undefined}>{link.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="actions">
      <LanguageSwitcher locale={locale} page={page} />
      <button
        class="menu-button"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label={t(locale, "nav.openMenu")}
        data-label-open={t(locale, "nav.openMenu")}
        data-label-close={t(locale, "nav.closeMenu")}
      >
        <Menu class="icon-open" aria-hidden="true" />
        <X class="icon-close" aria-hidden="true" />
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="mobile-menu" hidden>
    <nav class="container">
      <ul>
        {links.map((link) => (
          <li><a href={link.href} aria-current={link.current ? "page" : undefined}>{link.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<script>
  for (const header of document.querySelectorAll<HTMLElement>("[data-site-header]")) {
    const button = header.querySelector<HTMLButtonElement>(".menu-button");
    const menu = header.querySelector<HTMLElement>("#mobile-menu");
    if (!button || !menu) continue;
    const setOpen = (open: boolean, returnFocus = false) => {
      button.setAttribute("aria-expanded", String(open));
      button.setAttribute("aria-label", (open ? button.dataset["labelClose"] : button.dataset["labelOpen"]) ?? "");
      menu.hidden = !open;
      if (open) menu.querySelector<HTMLAnchorElement>("a")?.focus();
      else if (returnFocus) button.focus();
    };
    button.addEventListener("click", () => setOpen(button.getAttribute("aria-expanded") !== "true"));
    header.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && !menu.hidden) setOpen(false, true);
    });
    window.matchMedia("(min-width: 1024px)").addEventListener("change", (event) => {
      if (event.matches) setOpen(false);
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: 64px;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav-desktop {
    display: none;
  }
  .nav-desktop ul {
    display: flex;
    gap: var(--space-8);
  }
  .nav-desktop a,
  .mobile-menu a {
    color: var(--color-text-body);
    text-decoration: none;
    font-weight: 500;
    padding-block: var(--space-2);
  }
  .nav-desktop a[aria-current="page"],
  .mobile-menu a[aria-current="page"] {
    color: var(--color-text);
    text-decoration: underline;
    text-decoration-color: var(--color-primary);
    text-decoration-thickness: 2px;
    text-underline-offset: 8px;
  }
  .actions {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }
  .menu-button {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-button);
    background: var(--color-surface);
    color: var(--color-text);
    cursor: pointer;
  }
  .menu-button .icon-close,
  .menu-button[aria-expanded="true"] .icon-open {
    display: none;
  }
  .menu-button[aria-expanded="true"] .icon-close {
    display: block;
  }
  .mobile-menu {
    border-top: 1px solid var(--color-border);
    background: var(--color-surface);
  }
  .mobile-menu nav {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding-block: var(--space-4) var(--space-6);
  }
  .mobile-menu ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .mobile-menu a {
    display: block;
  }

  @media (min-width: 1024px) {
    .bar {
      min-height: 72px;
    }
    .nav-desktop {
      display: block;
    }
    .menu-button,
    .mobile-menu {
      display: none;
    }
  }
</style>
