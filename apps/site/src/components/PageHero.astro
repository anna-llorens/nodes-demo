---
import Svg from "@nodes/ui/Svg.astro";
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import Eyebrow from "./Eyebrow.astro";

/**
 * Page hero: eyebrow pill, the page's h1 and lead; skyline on the right (below on mobile).
 * The `aside` slot replaces the skyline (e.g. the demo's simulation notice); with an `image` or
 * `plain` it goes under the lead instead. An `image` also replaces the skyline: on desktop the photo bleeds to the right edge with its left side faded into the
 * page, like the home hero. `plain` drops the right column: a shorter, text-only hero in a
 * 48rem column, the width of the contact form below it; `centered` also centres its text.
 * `backdrop` (with an `image`) fills the whole hero with the photo behind white text on a dark
 * band, like the article header; the title is not width-limited.
 */
interface Props {
  id: string;
  eyebrow: string;
  title: string;
  lead: string;
  image?: ImageMetadata;
  imageAlt?: string;
  plain?: boolean;
  centered?: boolean;
  backdrop?: boolean;
}
const { id, eyebrow, title, lead, image, imageAlt = "", plain = false, centered = false, backdrop = false } = Astro.props;
---

<section
  class:list={["hero", { "has-photo": image && !backdrop, backdrop: image && backdrop, plain, centered }]}
  aria-labelledby={id}
>
  <div class="container layout">
    <div class="text">
      <Eyebrow badge>{eyebrow}</Eyebrow>
      <h1 id={id}>{title}</h1>
      <p class="lead">{lead}</p>
      {(image || plain) && Astro.slots.has("aside") && <slot name="aside" />}
    </div>
    {
      !image && !plain && Astro.slots.has("aside") ? (
        <div class="aside"><slot name="aside" /></div>
      ) : (
        !image && !plain && <span class="art"><Svg name="illustrations/skyline-header" /></span>
      )
    }
  </div>
  {
    image && (
      <div class="photo">
        <Image src={image} alt={imageAlt} widths={[640, 1024, 1600]} sizes="(min-width: 1024px) 70vw, 100vw" loading="eager" />
      </div>
    )
  }
</section>

<style>
  .hero {
    padding-top: var(--section-padding);
    overflow: hidden;
  }
  .text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-5);
  }
  .plain .text {
    max-width: 48rem;
    margin-inline: auto;
  }
  .centered .text {
    align-items: center;
    text-align: center;
  }
  .lead {
    margin: 0;
    max-width: 48ch;
    font-size: 1.125rem;
  }
  .aside {
    margin-top: var(--space-8);
  }
  .art {
    display: block;
    margin-top: var(--space-8);
    color: var(--color-primary);
  }
  .photo {
    margin-top: var(--space-8);
  }
  .photo :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
  .art :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }
  /* Backdrop: the photo fills the hero; a dark gradient on the left keeps the white text legible. */
  .hero.backdrop {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 60svh;
    padding-block: var(--space-12);
    background: var(--color-surface-inverse);
    color: var(--color-text-inverse);
  }
  .backdrop .layout {
    position: relative;
    z-index: 1;
    display: block;
    width: 100%;
  }
  .backdrop .text {
    width: auto;
    padding-bottom: 0;
  }
  .backdrop h1,
  .backdrop .lead {
    color: var(--color-text-inverse);
  }
  .backdrop h1 {
    max-width: none;
  }
  .backdrop .photo {
    position: absolute;
    inset: 0;
    width: 100%;
    margin: 0;
    mask-image: none;
  }
  .backdrop .photo :global(img) {
    height: 100%;
    object-fit: cover;
    object-position: right center;
  }
  .backdrop .photo::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      var(--color-surface-inverse) 0%,
      color-mix(in srgb, var(--color-surface-inverse) 70%, transparent) 50%,
      transparent 100%
    );
  }
  @media (min-width: 1024px) {
    .hero {
      padding-bottom: 0;
    }
    .layout {
      display: grid;
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      align-items: end;
      gap: var(--space-12);
    }
    .text {
      padding-bottom: var(--space-12);
    }
    .art,
    .aside {
      margin: 0;
    }
    .aside {
      align-self: center;
    }
    .plain .layout {
      display: block;
    }
    .plain .text {
      padding-bottom: 0;
    }
    /* With a photo: text on the left half, photo bleeding off the right edge (as on the home). */
    .has-photo {
      position: relative;
      display: flex;
      align-items: center;
      min-height: 60svh;
      padding-block: var(--space-12);
    }
    .has-photo .layout {
      position: relative;
      z-index: 1;
      display: block;
    }
    .has-photo .text {
      width: 45%;
      padding-bottom: 0;
    }
    .has-photo .lead {
      max-width: 40ch;
    }
    .photo {
      position: absolute;
      inset: 0 0 0 auto;
      width: 70%;
      margin: 0;
      mask-image: linear-gradient(to right, transparent 5%, black 45%);
    }
    .photo :global(img) {
      height: 100%;
      object-fit: cover;
      object-position: right center;
    }
  }
</style>
