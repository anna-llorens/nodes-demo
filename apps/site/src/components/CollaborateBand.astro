---
import { Image } from "astro:assets";
import bandImage from "../assets/research/research-hero.webp";
import { t, type Locale } from "../i18n";
import { pagePath } from "../lib/routes";
import Button from "./Button.astro";

/**
 * Closing band of About, Research, Applications and Demo: dark, with the Research hero image
 * behind a left gradient, white text and a button, to Contact with the About label unless the
 * caller passes its own. The image is decorative here (the Research hero describes it). Callers
 * pass the already translated copy; the eyebrow is optional.
 */
interface Props {
  locale: Locale;
  /** Heading id, unique on the page. */
  id: string;
  eyebrow?: string;
  title: string;
  text: string;
  href?: string;
  label?: string;
}
const {
  locale,
  id,
  eyebrow,
  title,
  text,
  href = pagePath(locale, "contact"),
  label = t(locale, "about.collab.cta"),
} = Astro.props;
---

<section class="collab" aria-labelledby={id}>
  <Image class="bg" src={bandImage} alt="" widths={[640, 1024, 1600, 2000]} sizes="100vw" />
  <div class="container text">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h2 id={id}>{title}</h2>
    <p class="lead">{text}</p>
    <Button href={href} variant="outline" arrow>{label}</Button>
  </div>
</section>

<style>
  .collab {
    position: relative;
    overflow: hidden;
    background: var(--color-surface-inverse);
    color: var(--color-text-inverse);
  }
  .bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: right center;
  }
  /* Solid dark under the text, fading out to the right so the image shows there. */
  .collab::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      var(--color-surface-inverse) 0%,
      color-mix(in srgb, var(--color-surface-inverse) 70%, transparent) 50%,
      transparent 100%
    );
  }
  .text {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
    padding-block: var(--space-12);
  }
  .eyebrow {
    margin: 0;
    font-size: var(--text-eyebrow);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  h2 {
    font-size: var(--text-h2);
    color: var(--color-text-inverse);
  }
  .lead {
    margin: 0 0 var(--space-2);
    max-width: 52ch;
    color: var(--color-text-inverse);
  }
</style>
