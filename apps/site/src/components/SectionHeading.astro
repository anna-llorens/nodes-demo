---
import Eyebrow from "./Eyebrow.astro";

/** Optional eyebrow, title and lead of a section, in a column of at most 60 characters. */
interface Props {
  eyebrow?: string | undefined;
  title: string;
  lead?: string | undefined;
  /** Heading level: the page's h1 lives in its hero, sections use h2. */
  level?: "h1" | "h2";
  id?: string;
}
const { eyebrow, title, lead, level = "h2", id } = Astro.props;
const Heading = level;
---

<div class="section-heading">
  {eyebrow && <Eyebrow>{eyebrow}</Eyebrow>}
  <Heading id={id}>{title}</Heading>
  {lead && <p class="lead">{lead}</p>}
  <slot />
</div>

<style>
  .section-heading {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
    max-width: 60ch;
  }
  h2 {
    font-size: var(--text-h2);
    font-weight: 700;
  }
  h1,
  h2 {
    white-space: pre-line;
  }
  .lead {
    margin: 0;
  }
  .section-heading > :global(.button) {
    margin-top: var(--space-4);
  }
</style>
