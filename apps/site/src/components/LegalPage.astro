---
import { getEntry, render } from "astro:content";
import { t, type Locale } from "../i18n";
import Base from "../layouts/Base.astro";
import { legalEntryId, type LegalPage as Page } from "../lib/legal";
import { pages } from "../lib/routes";

/** Long-text template for the legal pages: title, draft banner while `draft: true`, Markdown body. */
interface Props {
  locale: Locale;
  page: Page;
}
const { locale, page } = Astro.props;
const entry = await getEntry("legal", legalEntryId(locale, page));
if (!entry) throw new Error(`Missing legal text: ${legalEntryId(locale, page)}`);
const { Content } = await render(entry);
const draft = entry.data.draft;
---

<Base locale={locale} page={page} noindex={draft}>
  <section class="section">
    <article class="container legal">
      <h1>{t(locale, pages[page].titleKey)}</h1>
      {draft && <p class="draft" role="note">{t(locale, "legal.draftBanner")}</p>}
      <div class="prose"><Content /></div>
    </article>
  </section>
</Base>

<style>
  .legal {
    display: flex;
    flex-direction: column;
    gap: var(--section-gap-inner);
    max-width: calc(70ch + 2 * var(--space-5));
  }
  .draft {
    margin: 0;
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-error);
    border-radius: var(--radius-button);
    background: var(--color-surface);
    color: var(--color-error);
    font-weight: 600;
  }
  .prose :global(h2) {
    margin: var(--space-8) 0 var(--space-3);
    font-size: 1.375rem;
    font-weight: 700;
  }
  .prose :global(h3) {
    margin: var(--space-6) 0 var(--space-2);
    font-size: 1.125rem;
    font-weight: 600;
  }
  .prose :global(:first-child) {
    margin-top: 0;
  }
  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 var(--space-4);
  }
  .prose :global(li + li) {
    margin-top: var(--space-2);
  }
</style>
