---
import Svg from "@nodes/ui/Svg.astro";

/**
 * Icon, a title and one short line, plus an optional slot under the text (e.g. a StatusLabel).
 * - `plain`: no card background. `bordered`: thin border instead of the shadow.
 * - `bareIcon`: the icon alone in primary, without the soft-green circle.
 * - `layout`: `stack` (icon above), `row` (icon beside the text), or `row-mobile` (beside on
 *   mobile, above on desktop; the home solution cards).
 */
interface Props {
  icon: string;
  title: string;
  text: string;
  plain?: boolean;
  bordered?: boolean;
  bareIcon?: boolean;
  layout?: "stack" | "row" | "row-mobile";
}
const { icon, title, text, plain = false, bordered = false, bareIcon = false, layout = "stack" } = Astro.props;
---

<article class:list={["icon-card", `layout-${layout}`, { plain, bordered, "bare-icon": bareIcon }]}>
  <span class="icon"><Svg name={icon} /></span>
  <div>
    <h3>{title}</h3>
    <p>{text}</p>
    <slot />
  </div>
</article>

<style>
  .icon-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    padding: var(--space-6);
    border-radius: var(--radius-card);
    background: var(--color-surface);
    box-shadow: var(--shadow-card);
  }
  .plain {
    padding: 0;
    background: none;
    box-shadow: none;
  }
  .bordered {
    border: 1px solid var(--color-border);
    box-shadow: none;
  }
  .layout-row,
  .layout-row-mobile {
    flex-direction: row;
    align-items: center;
  }
  .layout-row {
    align-items: flex-start;
    gap: var(--space-4);
  }
  .icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 4.5rem;
    height: 4.5rem;
    border-radius: 50%;
    background: var(--color-primary-soft);
    color: var(--color-primary);
  }
  .plain .icon {
    width: 3.5rem;
    height: 3.5rem;
  }
  .icon :global(svg) {
    width: 60%;
    height: 60%;
  }
  .bare-icon .icon {
    width: 2.5rem;
    height: 2.5rem;
    background: none;
  }
  .bare-icon .icon :global(svg) {
    width: 100%;
    height: 100%;
  }
  h3 {
    font-size: 1.0625rem;
    font-weight: 600;
  }
  p {
    margin: var(--space-2) 0 0;
  }
  div > :global(.status-label) {
    margin-top: var(--space-3);
  }
  @media (min-width: 1024px) {
    .layout-row-mobile {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
