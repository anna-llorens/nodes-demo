---
import Svg from "@nodes/ui/Svg.astro";
import Button from "./Button.astro";

/** Soft-green band closing a page: icon, title, short text and one button. */
interface Props {
  id: string;
  icon: string;
  title: string;
  text: string;
  href: string;
  label: string;
}
const { id, icon, title, text, href, label } = Astro.props;
---

<section class="section cta" aria-labelledby={id}>
  <div class="container band">
    <span class="icon"><Svg name={icon} /></span>
    <div class="text">
      <h2 id={id}>{title}</h2>
      <p>{text}</p>
    </div>
    <Button href={href} arrow>{label}</Button>
  </div>
</section>

<style>
  .cta {
    padding-top: 0;
  }
  .band {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-5);
    padding-block: var(--space-8);
    border-radius: var(--radius-card);
    background: var(--color-primary-soft);
  }
  .icon {
    display: grid;
    flex: none;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--color-surface);
    color: var(--color-primary);
  }
  .icon :global(svg) {
    width: 55%;
    height: 55%;
  }
  h2 {
    margin: 0;
    font-size: 1.25rem;
  }
  p {
    margin: var(--space-2) 0 0;
    max-width: 60ch;
  }

  @media (min-width: 1024px) {
    .band {
      flex-direction: row;
      align-items: center;
      padding-inline: var(--space-8);
    }
    .text {
      flex: 1;
    }
  }
</style>
