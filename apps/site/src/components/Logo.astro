---
import NodesLogo from "@nodes/ui/Logo.astro";
import type { Locale } from "../i18n";

/** The wordmark linking to the home page of the current locale. */
interface Props {
  locale: Locale;
  variant?: "light" | "dark";
}
const { locale, variant = "light" } = Astro.props;
---

<a class="logo" href={`/${locale}/`}><NodesLogo variant={variant} /></a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  .logo :global(.nodes-logo) {
    height: 1.375rem;
  }
</style>
