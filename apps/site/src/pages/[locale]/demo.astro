---
import CollaborateBand from "../../components/CollaborateBand.astro";
import PageHero from "../../components/PageHero.astro";
import { isLocale, t } from "../../i18n";
import Base from "../../layouts/Base.astro";
import { pagePath } from "../../lib/routes";
import { localePaths } from "../../lib/static-paths";
import Scenarios from "../../sections/demo/Scenarios.astro";

export const getStaticPaths = localePaths;

const { locale } = Astro.params;
if (!isLocale(locale)) throw new Error(`Unknown locale: ${locale}`);
---

<Base locale={locale} page="demo">
  <PageHero
    id="demo-hero-title"
    eyebrow={t(locale, "demo.hero.eyebrow")}
    title={t(locale, "demo.hero.title")}
    lead={t(locale, "demo.hero.lead")}
    plain
    centered
  />
  <Scenarios locale={locale} />
  <CollaborateBand
    locale={locale}
    id="demo-after-title"
    title={t(locale, "demo.after.title")}
    text={t(locale, "demo.after.text")}
    href={pagePath(locale, "contact")}
    label={t(locale, "demo.after.cta")}
  />
</Base>
