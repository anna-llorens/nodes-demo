---
import { isLocale } from "../../i18n";
import Base from "../../layouts/Base.astro";
import { localePaths } from "../../lib/static-paths";
import Contact from "../../sections/collaborate/Contact.astro";
import Hero from "../../sections/collaborate/Hero.astro";
import Types from "../../sections/collaborate/Types.astro";

export const getStaticPaths = localePaths;

const { locale } = Astro.params;
if (!isLocale(locale)) throw new Error(`Unknown locale: ${locale}`);
---

<Base locale={locale} page="collaborate">
  <Hero locale={locale} />
  <Types locale={locale} />
  <Contact locale={locale} />
</Base>
