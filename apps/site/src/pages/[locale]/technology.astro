---
import { isLocale } from "../../i18n";
import Base from "../../layouts/Base.astro";
import Benefits from "../../sections/technology/Benefits.astro";
import Hero from "../../sections/technology/Hero.astro";
import PointCloud from "../../sections/technology/PointCloud.astro";
import Workflow from "../../sections/technology/Workflow.astro";

// Hidden for now: no locale is built, so the page and its sections stay in the code but are not
// published. To restore it, return `localePaths()` (from lib/static-paths) and add "technology"
// back to `mainNav` in lib/routes.ts.
export const getStaticPaths = () => [];

const { locale } = Astro.params;
if (!isLocale(locale)) throw new Error(`Unknown locale: ${locale}`);
---

<Base locale={locale} page="technology">
  <Hero locale={locale} />
  <Workflow locale={locale} />
  <PointCloud locale={locale} />
  <Benefits locale={locale} />
</Base>
