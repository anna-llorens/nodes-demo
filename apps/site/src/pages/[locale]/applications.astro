---
import CtaBand from "../../components/CtaBand.astro";
import PageHero from "../../components/PageHero.astro";
import { isLocale, t } from "../../i18n";
import Base from "../../layouts/Base.astro";
import { pagePath } from "../../lib/routes";
import { localePaths } from "../../lib/static-paths";
import Cards from "../../sections/applications/Cards.astro";

export const getStaticPaths = localePaths;

const { locale } = Astro.params;
if (!isLocale(locale)) throw new Error(`Unknown locale: ${locale}`);
---

<Base locale={locale} page="applications">
  <PageHero
    id="applications-hero-title"
    eyebrow={t(locale, "applications.hero.eyebrow")}
    title={t(locale, "applications.hero.title")}
    lead={t(locale, "applications.hero.lead")}
  />
  <Cards locale={locale} />
  <CtaBand
    id="pilot-title"
    icon="icons/lightbulb"
    title={t(locale, "applications.cta.title")}
    text={t(locale, "applications.cta.text")}
    href={`${pagePath(locale, "contact")}?interest=pilot`}
    label={t(locale, "applications.cta.button")}
  />
</Base>
