---
import heroImage from "../../../assets/research/research-hero.webp";
import CollaborateBand from "../../../components/CollaborateBand.astro";
import PageHero from "../../../components/PageHero.astro";
import { isLocale, t, type Key } from "../../../i18n";
import Base from "../../../layouts/Base.astro";
import { localePaths } from "../../../lib/static-paths";
import Cards from "../../../sections/research/Cards.astro";
import Questions from "../../../sections/research/Questions.astro";
import SectionNav from "../../../sections/research/SectionNav.astro";

export const getStaticPaths = localePaths;

const { locale } = Astro.params;
if (!isLocale(locale)) throw new Error(`Unknown locale: ${locale}`);
const sections = [
  { id: "publications", label: "research.list.eyebrow" },
  { id: "open-questions", label: "research.questions.eyebrow" },
] satisfies { id: string; label: Key }[];
---

<Base locale={locale} page="research">
  <PageHero
    id="research-hero-title"
    eyebrow={t(locale, "research.hero.eyebrow")}
    title={t(locale, "research.hero.title")}
    lead={t(locale, "research.hero.lead")}
    image={heroImage}
    imageAlt={t(locale, "research.hero.imageAlt")}
    backdrop
  />
  <SectionNav locale={locale} sections={sections} />
  <Cards locale={locale} />
  <Questions locale={locale} />
  <CollaborateBand
    locale={locale}
    id="research-collab-title"
    title={t(locale, "research.collab.title")}
    text={t(locale, "research.collab.text")}
  />
</Base>
