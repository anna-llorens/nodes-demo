---
import { getCollection, render } from "astro:content";
import { getImage, Image } from "astro:assets";
import Svg from "@nodes/ui/Svg.astro";
import { ArrowLeft, ArrowRight, Calendar, FileText, Tag } from "@lucide/astro";
import { isLocale, locales, t } from "../../../i18n";
import ArticleEngagement from "../../../components/ArticleEngagement.astro";
import Base, { type ArticleMeta } from "../../../layouts/Base.astro";
import { absoluteUrl } from "../../../lib/env";
import { jsonLd, organization } from "../../../lib/organization";
import { pagePath } from "../../../lib/routes";
import {
  articlePath,
  cardIcons,
  formatArticleDate,
  formatShortDate,
  relatedArticles,
  translationsOf,
} from "../../../lib/research";

/**
 * Research article. The build only includes published articles; `pnpm dev` also serves drafts,
 * with the draft note and noindex, so they can be reviewed.
 */
export async function getStaticPaths() {
  const entries = await getCollection("research", (entry) => import.meta.env.DEV || !entry.data.draft);
  return entries.map((entry) => ({
    params: { locale: entry.id.split("/")[0], slug: entry.data.slug },
    props: { entry },
  }));
}

const { locale } = Astro.params;
if (!isLocale(locale)) throw new Error(`Unknown locale: ${locale}`);
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const { title, subtitle, description, date, type, category, tags, author, draft, cover, coverAlt, card } = entry.data;
const toc = headings.filter((heading) => heading.depth === 2);
const published = date ? formatArticleDate(date, locale) : undefined;
// Eyebrow: category label (Research filters, raw key as fallback) · type · short date.
const categoryOf = (key: string) => t(locale, `research.filters.${key}` as Parameters<typeof t>[1]) ?? key;
const eyebrow = [categoryOf(category), type, date && formatShortDate(date, locale)]
  .filter(Boolean)
  .join(" · ");
const related = (await relatedArticles(entry)).map((item) => ({
  href: articlePath(item),
  title: item.data.title,
  category: categoryOf(item.data.category),
  date: item.data.date,
  cover: item.data.cover,
  icon: cardIcons[item.data.card as keyof typeof cardIcons] ?? cardIcons.lidar,
}));
// Drafts (dev only) get no alternates. The switcher goes to the other translation, or to the
// research index of a locale the article is not translated into.
const translations = draft ? undefined : await translationsOf(entry);
const languageHrefs = Object.fromEntries(
  locales.map((item) => [item, translations?.find((tr) => tr.locale === item)?.path ?? pagePath(item, "research")]),
);

// Share image: the cover cropped to 1200×630 JPEG, the size and format social previews expect.
const shareImage = cover && (await getImage({ src: cover, width: 1200, height: 630, fit: "cover", format: "jpg" }));
const metaDescription = description ?? subtitle;
const url = absoluteUrl(articlePath(entry));
const article: ArticleMeta = {
  // Same as published until the frontmatter has its own modified date.
  published: date || undefined,
  modified: date || undefined,
  section: categoryOf(category),
  tags,
  image: shareImage
    ? {
        url: absoluteUrl(shareImage.src),
        width: Number(shareImage.attributes["width"]),
        height: Number(shareImage.attributes["height"]),
        alt: coverAlt,
      }
    : undefined,
};
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BlogPosting",
      headline: title,
      description: metaDescription,
      ...(article.image && { image: article.image.url }),
      ...(date && { datePublished: date, dateModified: date }),
      inLanguage: locale,
      mainEntityOfPage: url,
      author: { "@type": "Person", name: author },
      publisher: organization(locale),
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: t(locale, "nav.home"), item: absoluteUrl(pagePath(locale, "home")) },
        { "@type": "ListItem", position: 2, name: t(locale, "nav.research"), item: absoluteUrl(pagePath(locale, "research")) },
        { "@type": "ListItem", position: 3, name: title, item: url },
      ],
    },
  ],
};
---

<Base
  locale={locale}
  title={title}
  description={metaDescription}
  noindex={draft}
  translations={translations}
  languageHrefs={languageHrefs}
  article={article}
>
  <script slot="head" type="application/ld+json" set:html={jsonLd(structuredData)} />
  <!-- Full-width dark header; the cover, when there is one, fills it behind a left gradient. -->
  <header class:list={["article-header", { "has-cover": cover }]}>
    {
      cover && (
        <Image
          class="cover"
          src={cover}
          alt={coverAlt ?? ""}
          widths={[640, 960, 1440, 1920]}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
        />
      )
    }
    <div class="container wide header-text">
      <a class="back" href={pagePath(locale, "research")}>
        <ArrowLeft aria-hidden="true" size={18} />
        {t(locale, "article.back")}
      </a>
      {draft && <p class="draft" role="note">{t(locale, "article.draftNote")}</p>}
      <p class="eyebrow">{eyebrow}</p>
      <h1>{title}</h1>
      <p class="subtitle">{subtitle}</p>
    </div>
  </header>

  <!-- On mobile the contents sit between header and body, and the aside (details, related) comes
       after the body. From 1280px the contents are a sticky left column and the aside the right
       column; between 1024px and 1279px both stack on the right. -->
  <div class="container wide layout">
    {
      toc.length > 0 && (
        <div class="toc-column">
          <details class="card toc" open>
            <summary id="article-toc-title">{t(locale, "article.toc.title")}</summary>
            <nav aria-labelledby="article-toc-title">
              <ol>
                {toc.map((heading, index) => (
                  <li>
                    <a href={`#${heading.slug}`} data-toc={heading.slug}>
                      <span class="num">{String(index + 1).padStart(2, "0")}</span>
                      {heading.text}
                    </a>
                  </li>
                ))}
              </ol>
            </nav>
          </details>
        </div>
      )
    }
    <!-- Share, hearts and comments sit under the text, before the aside's related articles. Drafts
         have none: their card key is not in the build's list of published articles. -->
    <div class="main-column">
      <article class="prose"><Content /></article>
      {!draft && card && <ArticleEngagement locale={locale} articleKey={card} title={title} url={url} author={author} />}
    </div>
    <aside>
      <dl class="card details">
        {
          published && (
            <div>
              <Calendar aria-hidden="true" size={20} />
              <dt>{t(locale, "article.details.publicationDate")}</dt>
              <dd>{published}</dd>
            </div>
          )
        }
        <div>
          <FileText aria-hidden="true" size={20} />
          <dt>{t(locale, "article.details.contentType")}</dt>
          <dd>{type}</dd>
        </div>
        {
          tags.length > 0 && (
            <div>
              <Tag aria-hidden="true" size={20} />
              <dt>{t(locale, "article.details.topics")}</dt>
              <dd>
                <ul class="tags">
                  {tags.map((tag) => (
                    <li>{tag}</li>
                  ))}
                </ul>
              </dd>
            </div>
          )
        }
      </dl>
      {
        related.length > 0 && (
          <section class="related" aria-labelledby="article-related-title">
            <h2 id="article-related-title">{t(locale, "article.related.title")}</h2>
            <ul>
              {related.map((item) => (
                <li>
                  <a href={item.href}>
                    {item.cover ? (
                      <Image class="thumb" src={item.cover} alt="" widths={[160, 320]} sizes="120px" />
                    ) : (
                      <span class="thumb panel">
                        <Svg name={item.icon} />
                      </span>
                    )}
                    <span class="related-text">
                      <span class="related-category">{item.category}</span>
                      <span class="related-title">{item.title}</span>
                      <time datetime={item.date}>{formatShortDate(item.date, locale)}</time>
                    </span>
                    <ArrowRight aria-hidden="true" size={18} class="arrow" />
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }
    </aside>
  </div>
</Base>

<script>
  // Marks the TOC item of the section being read. Without JS the list stays plain links.
  const links = new Map(
    [...document.querySelectorAll<HTMLAnchorElement>("[data-toc]")].map((link) => [link.dataset["toc"], link]),
  );
  const sections = [...links.keys()].flatMap((id) => document.getElementById(id ?? "") ?? []);
  const setCurrent = (id: string) =>
    links.forEach((link, key) => (key === id ? link.setAttribute("aria-current", "true") : link.removeAttribute("aria-current")));
  const first = sections[0];
  if (first) {
    setCurrent(first.id);
    const observer = new IntersectionObserver(
      () => {
        // Current = the last heading above the upper third of the viewport.
        const line = window.innerHeight / 3;
        const passed = sections.filter((section) => section.getBoundingClientRect().top <= line);
        setCurrent((passed.at(-1) ?? first).id);
      },
      { rootMargin: "0px 0px -66% 0px" },
    );
    sections.forEach((section) => observer.observe(section));
  }
</script>

<style>
  .article-header {
    position: relative;
    overflow: hidden;
    background: var(--color-surface-inverse);
    color: var(--color-text-inverse-muted);
  }
  .cover {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: right center;
  }
  /* Solid dark under the text column, fading out to the right so the image shows there. */
  .has-cover::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      var(--color-surface-inverse) 0%,
      color-mix(in srgb, var(--color-surface-inverse) 92%, transparent) 40%,
      color-mix(in srgb, var(--color-surface-inverse) 35%, transparent) 75%,
      transparent 100%
    );
  }
  .header-text {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding-block: var(--space-8) var(--space-12);
  }
  .back {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
    color: var(--color-text-inverse);
    font-weight: 600;
    text-decoration: none;
  }
  .back:hover {
    text-decoration: underline;
  }
  .eyebrow {
    font-size: var(--text-eyebrow);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .draft {
    align-self: flex-start;
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-error);
    border-radius: var(--radius-button);
    background: var(--color-surface);
    color: var(--color-error);
    font-weight: 600;
  }
  .header-text p,
  h1 {
    margin: 0;
  }
  h1 {
    max-width: 20ch;
    color: var(--color-text-inverse);
  }
  .subtitle {
    max-width: 48ch;
    font-size: 1.125rem;
  }

  .layout {
    display: grid;
    gap: var(--space-8);
    padding-block: var(--space-8) var(--space-12);
  }
  article {
    max-width: 70ch;
  }
  .prose :global(h2:first-child) {
    margin-top: 0;
  }
  .prose :global(h2) {
    margin: var(--space-8) 0 var(--space-3);
    font-size: 1.375rem;
    font-weight: 700;
    scroll-margin-top: calc(72px + var(--space-6));
  }
  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 var(--space-4);
  }
  /* Article images: full column width, never wider than the text column. */
  .prose :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-card, 12px);
  }
  /* Image caption: the italic line right after an image. */
  .prose :global(p:has(> img) + p > em:only-child) {
    display: block;
    margin-top: calc(-1 * var(--space-2));
    font-size: var(--text-small);
    color: var(--color-text-muted, inherit);
  }

  aside,
  .toc-column {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    font-size: var(--text-small);
  }
  .card {
    margin: 0;
    padding: var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background: var(--color-surface-muted);
  }
  summary {
    color: var(--color-text);
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
  }
  .toc[open] summary {
    margin-bottom: var(--space-3);
  }
  ol,
  .tags {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  ol a {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-2);
    border-radius: var(--radius-button);
    color: var(--color-text-body);
    text-decoration: none;
  }
  ol a:hover {
    color: var(--color-text);
  }
  .num {
    display: inline-grid;
    flex: none;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    color: var(--color-primary);
    font-size: var(--text-eyebrow);
    font-weight: 700;
  }
  ol a[aria-current] {
    background: var(--color-primary-soft);
    color: var(--color-text);
  }
  ol a[aria-current] .num {
    background: var(--color-primary);
    color: var(--color-on-primary);
  }
  .details {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .details > div {
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: var(--space-3);
  }
  .details svg {
    grid-row: span 2;
    color: var(--color-primary);
  }
  dt {
    color: var(--color-text);
  }
  dd {
    margin: 0;
    color: var(--color-text-muted);
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-2);
  }
  .tags li {
    padding: 2px var(--space-3);
    border: 1px solid var(--color-primary-line);
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    color: var(--color-primary);
  }

  .related h2 {
    margin: var(--space-4) 0 var(--space-3);
    color: var(--color-text);
    font-size: 1.125rem;
  }
  .related ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .related a {
    display: grid;
    grid-template-columns: 120px minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-4);
    color: var(--color-text-muted);
    text-decoration: none;
  }
  .related a:hover .related-title {
    color: var(--color-primary);
  }
  .thumb {
    display: block;
    width: 120px;
    height: auto;
    aspect-ratio: 3 / 2;
    border-radius: var(--radius-button);
    object-fit: cover;
  }
  .panel {
    display: grid;
    place-items: center;
    background: var(--color-primary-soft);
    color: var(--color-primary);
  }
  .panel :global(svg) {
    width: 36px;
    height: 36px;
  }
  .related-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .related-category {
    color: var(--color-primary);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .related-title {
    color: var(--color-text);
    font-weight: 600;
    line-height: 1.3;
  }
  time {
    font-size: var(--text-eyebrow);
    text-transform: uppercase;
  }
  .related :global(.arrow) {
    color: var(--color-text);
  }

  @media (min-width: 1024px) {
    .header-text {
      padding-block: var(--space-12);
    }
    .layout {
      grid-template-columns: minmax(0, 1fr) 320px;
      grid-template-areas:
        "article toc"
        "article aside";
      grid-template-rows: auto 1fr;
      column-gap: var(--space-12);
      row-gap: var(--space-4);
    }
    .toc-column {
      grid-area: toc;
    }
    /* Not sticky: with related articles the column is taller than the viewport. */
    aside {
      grid-area: aside;
      align-self: start;
    }
    .main-column {
      grid-area: article;
    }
    /* Always open on desktop: the summary is just the card title. */
    summary {
      pointer-events: none;
      list-style: none;
    }
    summary::-webkit-details-marker {
      display: none;
    }
  }

  /* Three columns: sticky contents, text, aside. The article page is wider than the site container,
     and the side columns and gaps are narrower than on tablets, so the text column gets about
     760px (~84 characters per line) at 1440px: long articles read shorter. */
  @media (min-width: 1280px) {
    .wide {
      max-width: 1400px;
    }
    .layout {
      grid-template-columns: 240px minmax(0, 1fr) 300px;
      grid-template-areas: "toc article aside";
      grid-template-rows: auto;
      column-gap: var(--space-8);
    }
    article {
      max-width: 80ch;
    }
    /* Under the site header (72px + 1px border), scrolling on its own if it is taller than the
       viewport. */
    .toc-column {
      position: sticky;
      top: calc(73px + var(--space-6));
      align-self: start;
      max-height: calc(100vh - 73px - var(--space-12));
      overflow-y: auto;
    }
  }
</style>
