---
import { isLocale } from "../../i18n";
import Base from "../../layouts/Base.astro";
import { jsonLd, organization } from "../../lib/organization";
import { localePaths } from "../../lib/static-paths";
import Featured from "../../sections/home/Featured.astro";
import Hero from "../../sections/home/Hero.astro";
import Project from "../../sections/home/Project.astro";
import Research from "../../sections/home/Research.astro";
import Sectors from "../../sections/home/Sectors.astro";

export const getStaticPaths = localePaths;

const { locale } = Astro.params;
if (!isLocale(locale)) throw new Error(`Unknown locale: ${locale}`);

const structuredData = { "@context": "https://schema.org", ...organization(locale) };
---

<Base locale={locale} page="home">
  <script slot="head" type="application/ld+json" set:html={jsonLd(structuredData)} />
  <Hero locale={locale} />
  <Sectors locale={locale} />
  <Featured locale={locale} />
  <Project locale={locale} />
  <Research locale={locale} />
</Base>
