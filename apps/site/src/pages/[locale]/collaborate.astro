---
import { isLocale } from "../../i18n";
import { pagePath } from "../../lib/routes";
import { localePaths } from "../../lib/static-paths";

// Old Colabora page: Contact replaced it (phase 2). Static build emits a redirect page.
export const getStaticPaths = localePaths;

const { locale } = Astro.params;
if (!isLocale(locale)) throw new Error(`Unknown locale: ${locale}`);
return Astro.redirect(pagePath(locale, "contact"), 301);
---
